<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VariLab.ViewModels"
             x:DataType="vm:DiagnosticsViewModel"
             x:Class="VariLab.Views.DiagnosticsView">

    <DockPanel Margin="12,10,12,10">

        <!-- Button bar -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <ToggleButton Classes="toolbar"
                          Content="⏸ Pause"
                          IsChecked="{Binding IsLogFrozen}"
                          ToolTip.Tip="Pause auto-scroll so you can read the log"/>
            <Button Content="Load Previous Log"
                    Command="{Binding LoadPreviousLogCommand}"
                    MinWidth="120"
                    ToolTip.Tip="Open a log file from a previous session"/>
            <Button Content="Save Log"
                    Classes="primary"
                    Command="{Binding SaveLogCommand}"
                    MinWidth="80"/>
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    MinWidth="80"/>
        </StackPanel>

        <!-- Log title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding LogTitle}"
                   Classes="hint"
                   Margin="2,0,0,6"/>

        <!-- Log list -->
        <Border Background="{StaticResource BrushBg}"
                CornerRadius="4"
                Padding="8"
                BorderThickness="1"
                BorderBrush="{StaticResource BrushSep}">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="13"
                                   TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

    </DockPanel>

</UserControl>
